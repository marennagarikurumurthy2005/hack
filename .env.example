DJANGO_SECRET_KEY=change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=village_governance
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
DJANGO_SQLITE_NAME=django.sqlite3

JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=village-governance

AUTO_BOOTSTRAP_BACKEND=False
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_VILLAGE=Head Office
SUPER_ADMIN_DISTRICT=Demo District
SUPER_ADMIN_STATE=Demo State
SUPER_ADMIN_PINCODE=500001

